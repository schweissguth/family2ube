{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mp4-to-hls",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "public" }
  ],
  "containers": [
    {
      "class_name": "HlsContainer",
      "image": "./container/Dockerfile",
      "max_instances": 5,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HLS_CONTAINER", "class_name": "HlsContainer" }
    ]
  },
  "exports": {
    "HlsContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
